                    <div class="border">
                        <img class="bg-dark" height="70" alt="GAMS" loading="lazy" src="{{context.env.DANGEROUS_GAMS3_PRODUCTION_ORIGIN}}/templates/img/gamslogo_weiss.gif"/><span class="ps-md-2">Digitale Infrastruktur GAMS</span>
                    </div>
                </a>

                <ul class="mt-2" style="">
                    <li><a class="text-dark" href="{{fn.root('datamodel.html')}}">FAIR Forschungsdaten</a>: <small>MEMOR stellt erschlossene Forschungsdaten nach den Prinzipien von FAIR und Open Science bereit.</small></li>
                    <li><a class="text-dark" href="https://digital-humanities.uni-graz.at/" target="_blank">DDH</a> Institut für Digitale Geisteswissenschaften</li>
